table Calendario
	lineageTag: 86520d09-455f-47e4-9095-ce9d4843b42f
	dataCategory: Time

	column Fecha
		dataType: dateTime
		isKey
		formatString: dd/mm/yyyy
		lineageTag: dd41fe04-c58c-4fa0-aba0-e8b01febe6a2
		summarizeBy: none
		sourceColumn: [Fecha]

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Año
		dataType: int64
		formatString: 0
		lineageTag: ccbcb008-c713-41c0-a4cb-faf6a1c8879e
		summarizeBy: none
		sourceColumn: [Año]

		annotation SummarizationSetBy = Automatic

	column NumMes
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: e1354a50-f678-49cf-b55c-191e636b6f19
		summarizeBy: none
		sourceColumn: [NumMes]

		annotation SummarizationSetBy = Automatic

	column Mes
		dataType: string
		lineageTag: 3d065101-4f0f-457c-ac4a-2a50168bf8f1
		summarizeBy: none
		sourceColumn: [Mes]
		sortByColumn: NumMes

		annotation SummarizationSetBy = Automatic

	column AñoMes
		dataType: string
		lineageTag: 7450b014-ca93-4247-8a28-800a6e7065b9
		summarizeBy: none
		sourceColumn: [AñoMes]

		annotation SummarizationSetBy = Automatic

	column Trimestre
		dataType: string
		lineageTag: f5a5b7a5-22b0-4713-8d19-09237177edb5
		summarizeBy: none
		sourceColumn: [Trimestre]

		annotation SummarizationSetBy = Automatic

	column DiaSemana
		dataType: int64
		formatString: 0
		lineageTag: f330adda-d07c-4200-ab2b-698a559dd3f8
		summarizeBy: none
		sourceColumn: [DiaSemana]

		annotation SummarizationSetBy = Automatic

	column EsLaborable
		dataType: boolean
		lineageTag: 9579d717-3c52-4fd6-b588-dc0a2080daba
		summarizeBy: none
		sourceColumn: [EsLaborable]

		annotation SummarizationSetBy = Automatic

	partition Calendario = calculated
		mode: import
		source =
				VAR _Inicio = DATE ( YEAR ( MIN ( Precios[Fecha] ) ), 1, 1 )
				VAR _Fin = DATE ( YEAR ( MAX ( Precios[Fecha] ) ), 12, 31 )
				VAR _Base = SELECTCOLUMNS ( CALENDAR ( _Inicio, _Fin ), "Fecha", [Date] )
				RETURN
				    ADDCOLUMNS (
				        _Base,
				        "Año", YEAR ( [Fecha] ),
				        "NumMes", MONTH ( [Fecha] ),
				        "Mes", FORMAT ( [Fecha], "mmm" ),
				        "AñoMes", FORMAT ( [Fecha], "yyyy-mm" ),
				        "Trimestre", "T" & QUARTER ( [Fecha] ),
				        "DiaSemana", WEEKDAY ( [Fecha], 2 ),
				        "EsLaborable", WEEKDAY ( [Fecha], 2 ) <= 5
				    )

