model Model
	culture: es-ES
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-ES
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["RutaDatos","Precios","Tickers"]

annotation PBI_ProTooling = ["DevMode"]

ref table Precios
ref table Tickers
ref table Calendario
ref table _Medidas

ref cultureInfo es-ES

